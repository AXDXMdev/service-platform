{
  "expo": {
    "name": "Hilfinio",
    "slug": "hilfinio-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hilfinio",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f8fc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.hilfinio.mobile"
    },
    "android": {
      "package": "de.hilfinio.mobile"
    },
    "extra": {
      "apiMode": "supabase-or-mock"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
