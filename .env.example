NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for admin support APIs. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin in production. Use long, random, different values.
# ADMIN_PANEL_PASSWORD: at least 16 chars. ADMIN_PANEL_SECRET is accepted as alias.
# ADMIN_PANEL_TOKEN: at least 32 chars and must be different from the password/secret.
ADMIN_PANEL_PASSWORD=
# ADMIN_PANEL_SECRET=
ADMIN_PANEL_TOKEN=

# Closed beta gate. When BETA_ACCESS_CODE is set, public pages require this code.
# BETA_ACCESS_TOKEN should be a separate long random value stored in the browser cookie.
BETA_ACCESS_CODE=
BETA_ACCESS_TOKEN=

# Optional Google AdSense configuration.
NEXT_PUBLIC_GOOGLE_ADS_CLIENT=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_HOME=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_SERVICES=

# Optional production hardening.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OBSERVABILITY_INGEST_URL=
OBSERVABILITY_INGEST_TOKEN=

# Cron/worker protection. Required before open launch.
CRON_SECRET=

# Upload security processors. Point these at hardened internal services before open launch.
UPLOAD_AV_SCAN_URL=
UPLOAD_AV_SCAN_TOKEN=
UPLOAD_IMAGE_SANITIZER_URL=
UPLOAD_IMAGE_SANITIZER_TOKEN=

# Mobile Expo client. Safe to expose because these are public client vars.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
