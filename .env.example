NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for admin support APIs. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin in production. Use long, random, different values.
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_TOKEN=

# Optional Google AdSense configuration.
NEXT_PUBLIC_GOOGLE_ADS_CLIENT=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_HOME=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_SERVICES=

# Mobile Expo client. Safe to expose because these are public client vars.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
